{
  "diff_view_style": "split",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "file_finder": {
    "include_ignored": "smart",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "semantic_tokens": "combined",
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  // "terminal": {
  //   "dock": "right",
  // },
  "inline_code_actions": true,
  "auto_signature_help": false,
  "sticky_scroll": {
    "enabled": false,
  },
  "rounded_selection": true,
  "current_line_highlight": "all",
  "unnecessary_code_fade": 0.3,
  "completions": {
    "lsp_fetch_timeout_ms": 0,
  },
  // "disable_ai": true,
  "colorize_brackets": true,
  "debugger": {
    "stepping_granularity": "line",
    "format_dap_log_messages": true,
    "log_dap_communications": true,
  },
  "soft_wrap": "editor_width",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enable_keep_preview_on_code_navigation": false,
  },
  "tabs": {
    "file_icons": false,
    "git_status": false,
  },
  // "status_bar": {
  //   "experimental.show": false,
  // },
  "title_bar": {
    "show_sign_in": true,
    "show_user_picture": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_onboarding_banner": true,
    "show_menus": false,
    "show_branch_icon": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "show_value_hints": false,
    "show_background": false,
    "enabled": false,
  },
  "minimap": {
    "thumb": "hover",
    "display_in": "active_editor",
    "show": "never",
  },
  "base_keymap": "Emacs",
  "agent_buffer_font_size": 14.0,
  "auto_update": false,
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "enabled": false,
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b",
            },
          ],
        },
      },
    },
    "profiles": {
      "coding": {
        "default_model": {
          "provider": "copilot_chat",
          "model": "gemini-3-flash-preview",
        },
        "name": "Coding",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
      "custom-testing": {
        "default_model": {
          "provider": "copilot_chat",
          "model": "gemini-3-flash-preview",
        },
        "name": "Custom Testing",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {
          "remote-mcp-server": {
            "tools": {
              "get_weather": true,
            },
          },
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview",
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.5",
    },
  },
  "cursor_blink": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Serendipity Morning",
    "dark": "Monokai Vibrant Amped",
  },
  "tab_bar": {
    // "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "show_whitespaces": "none",
  "unstable.ui_density": "compact",
  "gutter": {
    "folds": false,
    "runnables": false,
  },
  // "helix_mode": true,
  // "terminal": {
  //   "shell": {
  //     "program": "fish"
  //   }
  // },
  "relative_line_numbers": "enabled",
  "use_system_path_prompts": false,
  "search": {
    "regex": true,
  },
  "vim_mode": true,
  "scrollbar": {
    "cursors": true,
    "show": "never",
  },
  "git": {
    "git_gutter": null,
    "gutter_debounce": null,
    "inline_blame": {
      "show_commit_summary": false,
      "enabled": true,
    },
  },
  "active_pane_modifiers": {
    "border_size": 0.9,
    "inactive_opacity": 0.9,
  },
  "project_panel": {
    "dock": "left",
    "hide_hidden": true,
    "hide_gitignore": false,
    "button": true,
    "file_icons": true,
    "git_status": false,
    // "dock": "right",
  },
  "toolbar": {
    "selections_menu": true,
    "code_actions": false,
    // "breadcrumbs": false,
    "quick_actions": false,
  },
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "buffer_font_family": "Iosevka Mayukai Serif",
  "buffer_font_weight": 600,
  "ui_font_weight": 900,
  "ui_font_family": "Iosevka Mayukai Serif",
  // "buffer_font_family": "0xProto",
  // "ui_font_family": "0xProto",
  // other goated fonts
  // "Caskaydia Cove",
  // "0xProto",
  // ====
  "languages": {
    "Markdown": {
      "show_edit_predictions": false,
    },
    "JavaScript": {
      "show_whitespaces": "none",
      "format_on_save": "off",
      "indent_guides": {
        "enabled": false,
      },
      "inlay_hints": {
        "show_parameter_hints": true,
        "show_background": false,
        "show_other_hints": true,
        "show_type_hints": true,
        "show_value_hints": true,
        "enabled": false,
      },
    },
    "Python": {
      "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "indent_aware",
        "enabled": true,
      },
      "language_servers": ["ty", "ruff", "!basedpyright"],
    },
  },
  "agent_ui_font_size": 14.0,
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "tinymist": {
      "settings": {
        "exportPdf": "onType",
        "outputPath": "$root/$dir/$name",
      },
    },
  },
  "theme_overrides": {
    "Catppuccin Espresso (Blur)": {
      "warning": "#dec184ff",
      "title_bar.background": "#000",
      "background": "#000",
      "editor.debugger_active_line.background": "#fff",
    },
  },
  "context_servers": {
    "remote-mcp-server": {
      "settings": {},
      "url": "http://localhost:3001/sse",
    },
  },
}
