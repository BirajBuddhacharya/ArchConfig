// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//

// from the command palette.
[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space v": "pane::SplitRight",
      "space s": "pane::SplitDown",
      "space h": "workspace::ActivatePaneLeft",
      "space l": "workspace::ActivatePaneRight",
      "space j": "workspace::ActivatePaneDown",
      "space k": "workspace::ActivatePaneUp",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space t": "terminal_panel::Toggle",
      "space a": "agent::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "/": [
        "buffer_search::Deploy",
        { "focus": true, "selection_search_enabled": true },
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-shift-f": "editor::Format",
      "ctrl-shift-p": "file_finder::Toggle",
    },
  },
  {
    "context": "SettingsWindow",
    "bindings": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "RulesLibrary",
    "bindings": {
      "ctrl-w": "workspace::CloseWindow",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-b": "editor::ToggleBreakpoint",
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "ctrl-5 ctrl-8": "vim::PageUp",
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "ctrl-up": "vim::PageUp",
    },
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-4": ["vim::Literal", ["ctrl-b", "\u0002"]],
    },
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-7 ctrl-5": ["vim::Literal", ["ctrl-b", "\u0002"]],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-n": null,
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-p": "menu::SelectPrevious",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-w": ["terminal::SendKeystroke", "ctrl-w"],
      "ctrl-q": null,
      "ctrl-e": "terminal::ToggleViMode",
      "ctrl-w ctrl-q": [
        "terminal::SendKeystroke",
        "plz don't exit my zed instance",
      ],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "alt-b": ["terminal::SendKeystroke", "alt-b"],
      "alt-f": ["terminal::SendKeystroke", "alt-f"],
      "alt-o": "editor::ToggleFocus",
      "ctrl-shift-p": "file_finder::Toggle",
    },
  },
  {
    "bindings": {
      "ctrl-q": null,
    },
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-w": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-]": "editor::Indent",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "5 4": "editor::Cancel",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == waiting",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == operator",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "vim_mode == replace",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "((VimControl && vim_mode == helix_normal) && !menu)",
    "bindings": {
      "ctrl-[": null,
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-[": "editor::Outdent",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-space": "terminal::ToggleViMode",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-space": "editor::ShowWordCompletions",
    },
  },
  {
    "context": "StashDiff > Editor",
    "unbind": {
      "ctrl-shift-space": "git::PopCurrentStash",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-~": "workspace::NewTerminal",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-i": "project_symbols::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-t": "project_symbols::Toggle",
    },
  },
]
